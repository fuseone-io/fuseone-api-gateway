# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fuseone_gateway
DB_USER=gateway
DB_PASSWORD=gateway
DB_SSLMODE=disable

# APISIX
APISIX_ADMIN_URL=http://localhost:9180
APISIX_API_KEY=your-api-key-here
APISIX_CONTROL_URL=http://localhost:9090

# JWT
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
JWT_EXPIRY_MINUTES=60
REFRESH_EXPIRY_DAYS=30

# Server
SERVER_PORT=8080
SERVER_CORS_ORIGINS=http://localhost:3000

# Debug / Troubleshooting
DEBUG_ENABLED=true
DEBUG_CALLBACK_URL=http://host.docker.internal:8080/internal/debug-logs
DEBUG_RETENTION_HOURS=48
DEBUG_MAX_ROWS=50000

# ClickHouse (optional - docker compose --profile clickhouse up)
CLICKHOUSE_ENABLED=false
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DATABASE=fuseone_analytics
CLICKHOUSE_USER=fuseone
CLICKHOUSE_PASSWORD=fuseone

# OAuth2 (optional)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
